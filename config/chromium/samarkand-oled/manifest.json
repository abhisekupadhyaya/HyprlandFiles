      "frame_inactive": [0, 0, 0],
      "background_tab": [39, 39, 42],
      "background_tab_inactive": [24, 24, 26],
      "toolbar": [17, 17, 19],
      "tab_text": [110, 168, 254],
      "tab_background_text": [163, 166, 175],
      "tab_background_text_inactive": [143, 147, 156],
      "toolbar_text": [214, 226, 240],
      "toolbar_button_icon": [214, 226, 240],
      "bookmark_text": [190, 193, 201],
