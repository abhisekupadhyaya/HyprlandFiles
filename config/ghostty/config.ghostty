# Load the cached wallpaper palette before drawing the terminal.
config-file = @HOME@/.local/state/hyprlandfiles/current/ghostty.conf
font-family = JetBrains Mono
font-size = 11
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.96
cursor-style = bar
keybind = ctrl+shift+f=start_search
# Optional shared Bash/VS Code style; installed by tools/terminal_setup.py.
config-file = ?@HOME@/.config/hyprlandfiles/terminal/ghostty.conf
