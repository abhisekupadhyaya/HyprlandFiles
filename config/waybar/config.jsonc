{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 4,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/apps",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "backlight",
    "wireplumber",
    "network",
    "battery",
    "custom/notifications",
    "tray",
    "custom/session"
  ],
  "custom/apps": {
    "format": "Apps",
    "tooltip-format": "HyprlandFiles menu \u00b7 Super+Ctrl+Space\nApplications \u00b7 Super+Space\nShortcuts \u00b7 Super+K",
    "on-click": "/usr/local/bin/hf-menu main",
    "on-click-right": "/usr/local/bin/hf-menu help"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": []
    }
  },
  "clock": {
    "format": "{:%a %d %b   %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "backlight": {
    "format": "\u2600 {percent}%",
    "on-scroll-up": "/usr/local/bin/hf-control brightness up",
    "on-scroll-down": "/usr/local/bin/hf-control brightness down",
    "on-click": "/usr/local/bin/hf-menu brightness"
  },
  "wireplumber": {
    "format": "Vol {volume}%",
    "format-muted": "Muted",
    "on-click": "pavucontrol",
    "on-click-right": "/usr/local/bin/hf-control volume mute",
    "on-scroll-up": "/usr/local/bin/hf-control volume up",
    "on-scroll-down": "/usr/local/bin/hf-control volume down"
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "Wired",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname} \u00b7 {ipaddr}",
    "on-click": "/usr/local/bin/hf-menu network"
  },
  "battery": {
    "format": "Bat {capacity}%",
    "format-charging": "AC {capacity}%",
    "format-full": "AC {capacity}%",
    "states": {
      "warning": 25,
      "critical": 10
    },
    "tooltip-format": "{capacity}% \u00b7 {timeTo}",
    "on-click": "/usr/local/bin/hf-menu battery"
  },
  "custom/notifications": {
    "format": "Bell",
    "tooltip-format": "Notifications \u00b7 Super+Alt+N",
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d"
  },
  "tray": {
    "spacing": 8,
    "icon-size": 16
  },
  "custom/session": {
    "format": "Session",
    "tooltip-format": "Lock / Log out / Server mode / Restart / Shut down",
    "on-click": "/usr/local/bin/hf-menu power"
  }
}
